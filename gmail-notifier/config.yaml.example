# Gmail 데스크탑 알림 설정 예시
# 이 파일을 config.yaml로 복사해서 사용하세요.

# 이메일 폴링 간격 (초)
poll_interval_seconds: 30

# OAuth2 관련 파일 경로
credentials_file: credentials.json
token_file: token.json

# 알림 소리 설정
sound:
  enabled: true
  # 커스텀 사운드 파일 경로 (WAV/MP3). 비워두면 시스템 비프음 사용.
  # Linux: paplay → aplay → ffplay → mpg123 순으로 시도
  file: ""
  # 시스템 비프음 설정 (file이 비어 있을 때만 사용)
  beep_frequency: 880    # Hz (기본: 880 = A5음)
  beep_duration_ms: 300  # 재생 시간 (밀리초)

# ─────────────────────────────────────────────
# 알림 필터 규칙
# ─────────────────────────────────────────────
#
# [기본 규칙]
#   - from    : 발신자 주소에 해당 문자열이 포함되면 매칭 (대소문자 무관, 부분 일치)
#   - subject : 제목에 해당 문자열이 포함되면 매칭 (대소문자 무관, 부분 일치)
#   - 빈 문자열("")은 "모두 허용" 을 의미합니다.
#
# [AND 조건 — 하나의 필터 항목 안에서]
#   from과 subject 를 둘 다 지정하면 두 조건을 모두 만족해야 알림이 옵니다.
#
#   예) noreply@github.com 에서 온 제목에 "merged" 가 포함된 이메일만 알림
#     - from: "github.com"
#       subject: "merged"
#
# [OR 조건 — 여러 필터 항목 사이]
#   필터 항목이 여럿이면 그 중 하나라도 매칭되면 알림이 옵니다.
#
#   예) GitHub 메일이거나, 제목에 "긴급"이 있는 이메일이면 알림
#     - from: "github.com"
#       subject: ""
#     - from: ""
#       subject: "긴급"
#
# [필터 없음 — filters 를 완전히 비워두면]
#   모든 수신 이메일에 알림이 옵니다.
#
#     filters: []
#
# ─────────────────────────────────────────────
# 아래는 복합 예시:
#   1) github.com 발신 + 제목에 "merged" 포함  (AND)
#   2) boss@company.com 발신이면 제목 무관      (OR)
#   3) 발신자 무관 + 제목에 "긴급" 포함         (OR)
# ─────────────────────────────────────────────
filters:
  - from: "github.com"
    subject: "merged"
  - from: "boss@company.com"
    subject: ""
  - from: ""
    subject: "긴급"
