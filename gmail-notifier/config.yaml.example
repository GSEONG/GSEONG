# Gmail 데스크탑 알림 설정 예시
# 이 파일을 config.yaml로 복사해서 사용하세요.

# 이메일 폴링 간격 (초)
poll_interval_seconds: 30

# OAuth2 관련 파일 경로
credentials_file: credentials.json
token_file: token.json

# 알림 소리 설정
sound:
  enabled: true
  # 커스텀 사운드 파일 경로 (WAV/MP3). 비워두면 시스템 비프음 사용.
  # Linux: paplay → aplay → ffplay → mpg123 순으로 시도
  file: ""
  # 시스템 비프음 설정 (file이 비어 있을 때만 사용)
  beep_frequency: 880    # Hz (기본: 880 = A5음)
  beep_duration_ms: 300  # 재생 시간 (밀리초)

# ─────────────────────────────────────────────
# 알림 필터 규칙
# ─────────────────────────────────────────────
#
# [필드 구조]
#   from    : 발신자 주소에 매칭할 키워드 목록
#   subject : 제목에 매칭할 키워드 목록
#   regex   : true이면 키워드를 정규표현식으로 처리 (기본값: false)
#
# [키워드 매칭 방식]
#   - regex: false (기본) → 대소문자 무관 부분 일치
#   - regex: true         → Go 정규표현식 (대소문자 구분, (?i) 플래그로 무시 가능)
#   - 목록이 비어 있으면 해당 필드는 "모두 허용" (와일드카드)
#
# [AND 조건 — 하나의 필터 항목 안에서]
#   from 목록과 subject 목록이 둘 다 매칭되어야 알림이 옵니다.
#   (각 목록 내부에서는 하나라도 매칭되면 통과 — 아래 OR 규칙 참조)
#
# [OR 조건 1 — 같은 필드의 키워드 목록 안에서]
#   from 또는 subject 에 키워드가 여러 개이면 하나라도 매칭되면 통과합니다.
#
#   예) github.com 또는 gitlab.com 발신 + 제목에 merged 또는 closed 포함
#     - from:
#         - "github.com"
#         - "gitlab.com"
#       subject:
#         - "merged"
#         - "closed"
#
# [OR 조건 2 — 여러 필터 항목 사이]
#   필터 항목이 여럿이면 그 중 하나라도 매칭되면 알림이 옵니다.
#
#   예) GitHub/GitLab 메일이거나, 제목에 긴급/urgent 가 있으면 알림
#     - from:
#         - "github.com"
#         - "gitlab.com"
#       subject: []
#     - from: []
#       subject:
#         - "긴급"
#         - "urgent"
#
# [필터 없음]
#   filters: []  → 모든 수신 이메일에 알림
#
# [정규표현식 예시]
#   regex: true 로 설정하면 Go regexp 문법을 사용합니다.
#   - 대소문자 무시: (?i)패턴
#   - 도메인 정확히 일치: @(github|gitlab)\.com$
#   - 제목 시작 일치: ^\[긴급\]
#
# ─────────────────────────────────────────────
# 아래는 복합 예시:
#
#   항목 1) GitHub/GitLab 발신 AND 제목에 merged/closed/approved 중 하나 포함
#   항목 2) boss@company.com 발신이면 제목 무관 (와일드카드)
#   항목 3) 정규표현식 — 제목이 [긴급] 또는 [URGENT] 로 시작하는 이메일
# ─────────────────────────────────────────────
filters:
  - from:
      - "github.com"
      - "gitlab.com"
    subject:
      - "merged"
      - "closed"
      - "approved"

  - from:
      - "boss@company.com"
    subject: []

  - from: []
    subject:
      - "^\\[긴급\\]"
      - "^\\[URGENT\\]"
    regex: true
